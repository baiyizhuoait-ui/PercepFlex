# TRAC project ignores

# Data (large)
data/
../trac_data/

# Experiments outputs (checkpoint/metrics kept under experiments/exp_XXX/ are
# large; keep config.yaml + metrics.json tracked, ignore weights/logs)
experiments/*/checkpoint.pt
experiments/*/training_log.txt
experiments/*/*.csv

# Baseline repos keep their own .git; ignore their weight files
baselines/*/pretrained/
baselines/*/weights/
*.pth
*.pt
*.onnx
*.safetensors

# Python
__pycache__/
*.pyc
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
experiments/*/kd_cache/
experiments/expF_single_teacher/kd_cache/

# Baseline/teacher weights and key trained models (uploaded for the server)
!weights/
!trained_models/
!weights/*.pth
!trained_models/*.pt
