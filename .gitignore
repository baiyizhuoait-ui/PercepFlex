# TRAC project ignores

# Data (large)
data/
../trac_data/

# Experiments outputs (checkpoint/metrics kept under experiments/exp_XXX/ are
# large; keep config.yaml + metrics.json tracked, ignore weights/logs)
# ignore weights/logs at ANY depth (the old `experiments/*/...` only matched one
# level and missed experiments/phaseX/expY/training_log.txt -> bloated commits)
experiments/**/checkpoint.pt
**/training_log.txt
experiments/*/*.csv

# ...but the aggregated sweep RESULT TABLES are the deliverable: they are small
# and carry params/FLOPs/per-task metrics/git-commit for every run. Without them
# a phase is not reproducible, so un-ignore them.
#
# The rule is GENERIC on purpose. It used to be a hand-maintained list
# (`!experiments/phase2b/*_results.csv`, then one `!experiments/phaseX/*.csv`
# per phase), and that failed exactly twice:
#   * phase6 was never added -> every Phase-6 table (registry / hypotheses /
#     round-2 statistics) was silently untracked for days;
#   * phase2b's `r1r2_paramaudit.csv` does not end in `_results.csv`, so the
#     narrow whitelist never matched it.
# Adding a phase directory must not require remembering to edit this file --
# that IS the failure class. Enforced by check_repo_hygiene.sh assertion A1b.
!experiments/phase*/**/*.csv

# Baseline repos keep their own .git; ignore their weight files
baselines/*/pretrained/
baselines/*/weights/
*.pth
*.pt
*.onnx
*.safetensors

# Python
__pycache__/
*.pyc
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
# The 2026-09-10 Phase-1B/2B/2C directory reorganisation moved the KD feature
# cache to experiments/phase2b/expF_single_teacher/kd_cache/. The two literal
# rules that used to sit here (`experiments/*/kd_cache/` and
# `experiments/expF_single_teacher/kd_cache/`) matched NEITHER the new path, so
# 21 GB of *.npy was one `git add -A` away from being committed. Match at ANY
# depth, and keep NO literal path rules in this file: they rot silently on the
# next rename (check_repo_hygiene.sh assertion A4 exists to catch that).
experiments/**/kd_cache/

# Baseline/teacher weights and key trained models (uploaded for the server).
# NOTE: weights/YOLOP_End-to-end.pth is 95.7 MB -- 4.3 MB below GitHub's 100 MB
# hard limit, and ~83% of the packed repo. It is REGISTERED as an allowed large
# blob in scripts/hygiene_exceptions.txt (assertion A3), so the exception is
# auditable rather than implicit.
!weights/
!trained_models/
!weights/*.pth
!trained_models/*.pt

# Verbose run-log captures (stdout of train/eval/launcher, NOT deliverable data).
# Keep eval_stdout.log (small, provenance of reported metric) + metrics.json + config.yaml.
**/train_stdout.log
**/*_foreground.log
**/*_runner.log
**/*_monitor.log
**/*_launch.log
**/zsweep_*.log
**/r1r2_*.log
**/expA_*.log
**/expD_*.log
**/exp4C_*.log
**/*_diag.log
**/status.txt

# Ignore ALL run/verbose logs except the eval provenance log (deliverable).
# This catches ad-hoc logs (ours_*.log, dyn*.log, finish.log, *_eval.log, ...)
# that the specific patterns below might miss.
**/*.log
!**/eval_stdout.log

# baseline 公共仓库内容由服务器自行 clone，不纳入本仓库
baselines/

# Large derived cache / artifacts (never commit; GH001 rejects >100MB files)
*.npz
experiments/**/*.partial_*
experiments/**/clean_master_chain.log

