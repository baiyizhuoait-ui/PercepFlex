# TRAC project ignores

# Data (large)
data/
../trac_data/

# Experiments outputs (checkpoint/metrics kept under experiments/exp_XXX/ are
# large; keep config.yaml + metrics.json tracked, ignore weights/logs)
# ignore weights/logs at ANY depth (the old `experiments/*/...` only matched one
# level and missed experiments/phaseX/expY/training_log.txt -> bloated commits)
experiments/**/checkpoint.pt
experiments/**/training_log.txt
experiments/*/*.csv

# ...but the aggregated sweep RESULT TABLES are the deliverable of Phase 2-B:
# they are small, and they carry params/FLOPs/FPS/per-task metrics/git-commit for
# every run. Without them the sweep is not reproducible, so un-ignore them.
!experiments/phase2b/*_results.csv

# Same reasoning for the later phases: the aggregated result tables are the
# deliverable and the reports are generated from them. Un-ignore them so a
# phase is never committed with its numbers missing.
!experiments/phase3a/*.csv
!experiments/phase3b/*.csv
!experiments/phase3c/*.csv
!experiments/phase4a/*.csv
!experiments/phase5/*.csv

# Baseline repos keep their own .git; ignore their weight files
baselines/*/pretrained/
baselines/*/weights/
*.pth
*.pt
*.onnx
*.safetensors

# Python
__pycache__/
*.pyc
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
experiments/*/kd_cache/
experiments/expF_single_teacher/kd_cache/

# Baseline/teacher weights and key trained models (uploaded for the server)
!weights/
!trained_models/
!weights/*.pth
!trained_models/*.pt

# Verbose run-log captures (stdout of train/eval/launcher, NOT deliverable data).
# Keep eval_stdout.log (small, provenance of reported metric) + metrics.json + config.yaml.
**/train_stdout.log
**/*_foreground.log
**/*_runner.log
**/*_monitor.log
**/*_launch.log
**/zsweep_*.log
**/r1r2_*.log
**/expA_*.log
**/expD_*.log
**/exp4C_*.log
**/*_diag.log
**/status.txt

# baseline 公共仓库内容由服务器自行 clone，不纳入本仓库
baselines/
